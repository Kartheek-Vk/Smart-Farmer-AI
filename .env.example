DATABASE_URL=jdbc:postgresql://localhost:5432/smart_farmer_ai
DATABASE_NAME=smart_farmer_ai
DATABASE_USERNAME=smartfarmer
DATABASE_PASSWORD=smartfarmer
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=2592000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Leave empty until the external AI service exists; recommendations then stay PENDING.
AI_SERVICE_BASE_URL=
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT=5000
# Leave empty until a weather provider is configured; weather endpoints then answer 503.
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
WEATHER_API_TIMEOUT=5000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FILE_STORAGE_PATH=uploads
FILE_STORAGE_MAX_SIZE_BYTES=10485760
SERVER_PORT=8080
